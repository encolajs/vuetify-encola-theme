{
  "name": "vuetify-encola-theme",
  "version": "0.1.0",
  "description": "Encola turns Vuetify 4 into a flat, Tailwind-style UI — no Material Design, no forks. Drop-in theme with example pages, dark mode included.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "package": "git archive --format=zip --prefix=vuetify-encola-theme/ -o vuetify-encola-theme.zip HEAD"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@lucide/vue": "^1.31.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.1.0"
}
